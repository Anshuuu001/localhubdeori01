# LocalHub X - Environment Variables Guide
# Place sensitive configuration in local .env files. Never commit actual .env files.

# Server Configuration
PORT=5050
NODE_ENV=development
CORS_ORIGIN=http://localhost:5180

# MySQL Database Configuration
# In Phase 1, the app safely handles missing or unconfigured database connections.
# When ready to connect to your local MySQL instance:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Dear
DB_NAME=localhubx
DB_CONNECTION_LIMIT=10

# Taluka Configuration
DEFAULT_TALUKA_NAME="Deori Taluka"
DEFAULT_DISTRICT_NAME="Gondia"
DEFAULT_STATE_NAME="Maharashtra"

# Authentication & Session Security (Phase 2)
SESSION_SECRET="change-this-to-a-cryptographically-random-64-char-string"
OTP_SECRET="change-this-to-a-cryptographically-random-otp-hmac-secret"
SESSION_DURATION_DAYS=14
OTP_EXPIRY_MINUTES=10

# SMS Provider Configuration (Phase 2)
# Supported options: 'mock' (default in dev), 'fast2sms', 'twilio'
SMS_PROVIDER=mock
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email Provider Configuration (Phase 2)
# Supported options: 'mock' (default in dev), 'smtp'
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

